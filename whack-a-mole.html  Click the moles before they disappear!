<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Whack-a-Mole!</title>
<link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;700;900&display=swap" rel="stylesheet">
<style>
  :root {
    --green: #4caf50;
    --dark-green: #2e7d32;
    --dirt: #8B5E3C;
    --dirt-dark: #6D4C2A;
    --sky: #87CEEB;
    --yellow: #FFD600;
    --red: #FF3D00;
    --white: #fff;
    --shadow: rgba(0,0,0,0.18);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    min-height: 100vh;
    background: linear-gradient(180deg, #87CEEB 0%, #b2ebf2 60%, #4caf50 60%, #388e3c 100%);
    font-family: 'Nunito', sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    user-select: none;
  }

  h1 {
    font-family: 'Fredoka One', cursive;
    font-size: clamp(2rem, 6vw, 3.5rem);
    color: var(--white);
    text-shadow: 3px 4px 0 var(--dark-green), 0 0 30px rgba(0,0,0,0.15);
    letter-spacing: 2px;
    margin-bottom: 10px;
    animation: bounceIn 0.7s cubic-bezier(.36,1.56,.64,1) both;
  }

  @keyframes bounceIn {
    0% { transform: scale(0.4) translateY(-60px); opacity: 0; }
    100% { transform: scale(1) translateY(0); opacity: 1; }
  }

  .hud {
    display: flex;
    gap: 24px;
    margin-bottom: 18px;
    animation: bounceIn 0.8s 0.1s cubic-bezier(.36,1.56,.64,1) both;
  }

  .hud-box {
    background: var(--white);
    border-radius: 20px;
    padding: 8px 28px;
    box-shadow: 0 4px 0 var(--shadow);
    text-align: center;
    min-width: 110px;
  }

  .hud-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .hud-value {
    font-family: 'Fredoka One', cursive;
    font-size: 2rem;
    color: var(--dark-green);
    line-height: 1.1;
  }

  .hud-value.timer-low { color: var(--red); animation: pulse 0.5s infinite alternate; }

  @keyframes pulse { from { transform: scale(1); } to { transform: scale(1.15); } }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    padding: 28px;
    background: rgba(255,255,255,0.18);
    border-radius: 32px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
    backdrop-filter: blur(2px);
    animation: bounceIn 0.9s 0.15s cubic-bezier(.36,1.56,.64,1) both;
  }

  .hole {
    width: clamp(85px, 22vw, 130px);
    height: clamp(85px, 22vw, 130px);
    position: relative;
    cursor: pointer;
  }

  .hole-bg {
    width: 100%;
    height: 55%;
    background: radial-gradient(ellipse at center, #5a3a1a 60%, #3b200a 100%);
    border-radius: 50%;
    position: absolute;
    bottom: 0;
    left: 0;
    box-shadow: 0 6px 18px rgba(0,0,0,0.35);
  }

  .mole-wrap {
    position: absolute;
    bottom: 18%;
    left: 50%;
    transform: translateX(-50%) translateY(100%);
    transition: transform 0.18s cubic-bezier(.36,1.56,.64,1);
    z-index: 2;
    width: 70%;
  }

  .hole.active .mole-wrap {
    transform: translateX(-50%) translateY(0%);
  }

  .hole.whacked .mole-wrap {
    transform: translateX(-50%) translateY(-20%) rotate(-20deg) scale(0.7);
    transition: transform 0.1s;
  }

  .mole {
    width: 100%;
    display: block;
  }

  /* SVG Mole drawn inline */
  .mole-svg { width: 100%; height: auto; }

  .stars {
    position: absolute;
    pointer-events: none;
    z-index: 10;
    top: 0; left: 0; width: 100%; height: 100%;
    overflow: visible;
  }

  .star {
    position: absolute;
    font-size: 1.4rem;
    animation: starPop 0.6s ease-out forwards;
    pointer-events: none;
  }

  @keyframes starPop {
    0% { opacity: 1; transform: scale(0.5) translateY(0); }
    100% { opacity: 0; transform: scale(1.5) translateY(-50px); }
  }

  /* Start / Game Over screen */
  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    animation: fadeIn 0.3s;
  }

  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

  .overlay-box {
    background: white;
    border-radius: 32px;
    padding: 40px 48px;
    text-align: center;
    box-shadow: 0 16px 48px rgba(0,0,0,0.25);
    animation: bounceIn 0.5s cubic-bezier(.36,1.56,.64,1);
  }

  .overlay-box h2 {
    font-family: 'Fredoka One', cursive;
    font-size: 2.4rem;
    color: var(--dark-green);
    margin-bottom: 8px;
  }

  .overlay-box p {
    font-size: 1.1rem;
    color: #555;
    margin-bottom: 6px;
  }

  .final-score {
    font-family: 'Fredoka One', cursive;
    font-size: 4rem;
    color: var(--yellow);
    text-shadow: 3px 3px 0 #e65100;
    display: block;
    margin: 10px 0 18px;
  }

  .btn {
    background: var(--green);
    color: white;
    border: none;
    border-radius: 50px;
    padding: 14px 44px;
    font-family: 'Fredoka One', cursive;
    font-size: 1.4rem;
    cursor: pointer;
    box-shadow: 0 5px 0 var(--dark-green);
    transition: transform 0.1s, box-shadow 0.1s;
    letter-spacing: 1px;
  }

  .btn:active {
    transform: translateY(4px);
    box-shadow: 0 1px 0 var(--dark-green);
  }

  .btn:hover { background: #43a047; }

  .emoji-rain {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none;
    z-index: 99;
    overflow: hidden;
  }

  .rain-emoji {
    position: absolute;
    top: -60px;
    font-size: 2rem;
    animation: fall linear forwards;
  }

  @keyframes fall {
    to { top: 110vh; opacity: 0; }
  }

  .score-pop {
    position: absolute;
    font-family: 'Fredoka One', cursive;
    font-size: 1.6rem;
    color: var(--yellow);
    text-shadow: 2px 2px 0 #e65100;
    pointer-events: none;
    z-index: 20;
    animation: scorePop 0.8s ease-out forwards;
    left: 50%;
    transform: translateX(-50%);
    top: 0;
    white-space: nowrap;
  }

  @keyframes scorePop {
    0% { opacity: 1; top: 0; transform: translateX(-50%) scale(0.7); }
    60% { opacity: 1; top: -40px; transform: translateX(-50%) scale(1.2); }
    100% { opacity: 0; top: -65px; transform: translateX(-50%) scale(1); }
  }
</style>
</head>
<body>

<h1>🔨 Whack-a-Mole!</h1>

<div class="hud">
  <div class="hud-box">
    <div class="hud-label">Score</div>
    <div class="hud-value" id="score">0</div>
  </div>
  <div class="hud-box">
    <div class="hud-label">Time</div>
    <div class="hud-value" id="timer">30</div>
  </div>
  <div class="hud-box">
    <div class="hud-label">Best</div>
    <div class="hud-value" id="best">0</div>
  </div>
</div>

<div class="grid" id="grid"></div>

<!-- Start Overlay -->
<div class="overlay" id="startOverlay">
  <div class="overlay-box">
    <h2>🔨 Whack-a-Mole!</h2>
    <p>Moles pop up — click them fast!</p>
    <p>You have <strong>30 seconds</strong>. Good luck! 🐾</p>
    <br>
    <button class="btn" onclick="startGame()">▶ Start Game</button>
  </div>
</div>

<!-- Game Over Overlay -->
<div class="overlay" id="gameOverOverlay" style="display:none;">
  <div class="overlay-box">
    <h2>⏰ Time's Up!</h2>
    <p>Your Score:</p>
    <span class="final-score" id="finalScore">0</span>
    <p id="resultMsg"></p>
    <br>
    <button class="btn" onclick="startGame()">🔄 Play Again</button>
  </div>
</div>

<div class="emoji-rain" id="emojiRain"></div>

<script>
  const GRID_SIZE = 9;
  const GAME_DURATION = 30;

  let score = 0;
  let best = parseInt(localStorage.getItem('wam_best') || '0');
  let timeLeft = GAME_DURATION;
  let gameActive = false;
  let moleTimer = null;
  let countdownTimer = null;
  let activeMoles = new Set();

  const grid = document.getElementById('grid');
  const scoreEl = document.getElementById('score');
  const timerEl = document.getElementById('timer');
  const bestEl = document.getElementById('best');
  const gameOverEl = document.getElementById('gameOverOverlay');
  const finalScoreEl = document.getElementById('finalScore');
  const resultMsgEl = document.getElementById('resultMsg');

  bestEl.textContent = best;

  // Build grid
  for (let i = 0; i < GRID_SIZE; i++) {
    const hole = document.createElement('div');
    hole.className = 'hole';
    hole.dataset.index = i;
    hole.innerHTML = `
      <div class="hole-bg"></div>
      <div class="mole-wrap">
        <svg class="mole-svg" viewBox="0 0 80 90" xmlns="http://www.w3.org/2000/svg">
          <!-- Body -->
          <ellipse cx="40" cy="72" rx="28" ry="22" fill="#7B4F2E"/>
          <!-- Head -->
          <ellipse cx="40" cy="44" rx="26" ry="26" fill="#9B6B3E"/>
          <!-- Ears -->
          <ellipse cx="18" cy="30" rx="9" ry="11" fill="#9B6B3E"/>
          <ellipse cx="62" cy="30" rx="9" ry="11" fill="#9B6B3E"/>
          <ellipse cx="18" cy="30" rx="5" ry="7" fill="#e8a4b0"/>
          <ellipse cx="62" cy="30" rx="5" ry="7" fill="#e8a4b0"/>
          <!-- Face -->
          <ellipse cx="40" cy="52" rx="16" ry="12" fill="#c49a6c"/>
          <!-- Eyes -->
          <circle cx="32" cy="40" r="5" fill="white"/>
          <circle cx="48" cy="40" r="5" fill="white"/>
          <circle cx="33" cy="41" r="3" fill="#222"/>
          <circle cx="49" cy="41" r="3" fill="#222"/>
          <circle cx="34" cy="40" r="1" fill="white"/>
          <circle cx="50" cy="40" r="1" fill="white"/>
          <!-- Nose -->
          <ellipse cx="40" cy="50" rx="5" ry="3.5" fill="#d46b7a"/>
          <!-- Mouth -->
          <path d="M34 55 Q40 61 46 55" stroke="#7a3a3a" stroke-width="2" fill="none" stroke-linecap="round"/>
          <!-- Whiskers -->
          <line x1="20" y1="50" x2="36" y2="52" stroke="#888" stroke-width="1.2"/>
          <line x1="20" y1="54" x2="36" y2="54" stroke="#888" stroke-width="1.2"/>
          <line x1="44" y1="52" x2="60" y2="50" stroke="#888" stroke-width="1.2"/>
          <line x1="44" y1="54" x2="60" y2="54" stroke="#888" stroke-width="1.2"/>
          <!-- Claws -->
          <ellipse cx="28" cy="88" rx="5" ry="4" fill="#7B4F2E"/>
          <ellipse cx="40" cy="90" rx="5" ry="4" fill="#7B4F2E"/>
          <ellipse cx="52" cy="88" rx="5" ry="4" fill="#7B4F2E"/>
        </svg>
      </div>
    `;
    hole.addEventListener('click', () => whack(hole, i));
    grid.appendChild(hole);
  }

  function startGame() {
    document.getElementById('startOverlay').style.display = 'none';
    gameOverEl.style.display = 'none';
    score = 0;
    timeLeft = GAME_DURATION;
    gameActive = true;
    updateHUD();
    clearAllMoles();
    clearInterval(moleTimer);
    clearInterval(countdownTimer);
    popMoles();
    countdownTimer = setInterval(tick, 1000);
  }

  function tick() {
    timeLeft--;
    updateHUD();
    if (timeLeft <= 5) timerEl.classList.add('timer-low');
    if (timeLeft <= 0) endGame();
  }

  function updateHUD() {
    scoreEl.textContent = score;
    timerEl.textContent = timeLeft;
    bestEl.textContent = best;
  }

  function popMoles() {
    if (!gameActive) return;
    const speed = Math.max(500, 1200 - score * 15);
    moleTimer = setTimeout(() => {
      showRandomMole();
      popMoles();
    }, speed);
  }

  function showRandomMole() {
    const holes = grid.querySelectorAll('.hole:not(.active):not(.whacked)');
    if (!holes.length) return;
    const hole = holes[Math.floor(Math.random() * holes.length)];
    const idx = parseInt(hole.dataset.index);
    hole.classList.add('active');
    activeMoles.add(idx);
    const stayTime = Math.max(700, 1400 - score * 12);
    setTimeout(() => {
      if (hole.classList.contains('active')) {
        hole.classList.remove('active');
        activeMoles.delete(idx);
      }
    }, stayTime);
  }

  function whack(hole, idx) {
    if (!gameActive || !hole.classList.contains('active')) return;
    hole.classList.remove('active');
    hole.classList.add('whacked');
    activeMoles.delete(idx);
    score++;
    if (score > best) { best = score; localStorage.setItem('wam_best', best); }
    updateHUD();
    showScorePop(hole);
    showStars(hole);
    setTimeout(() => hole.classList.remove('whacked'), 400);
  }

  function showScorePop(hole) {
    const pop = document.createElement('div');
    pop.className = 'score-pop';
    pop.textContent = '+1';
    hole.appendChild(pop);
    setTimeout(() => pop.remove(), 800);
  }

  function showStars(hole) {
    const emojis = ['⭐','✨','💥','🌟'];
    for (let i = 0; i < 3; i++) {
      const s = document.createElement('div');
      s.className = 'star';
      s.textContent = emojis[Math.floor(Math.random()*emojis.length)];
      s.style.left = (20 + Math.random() * 60) + '%';
      s.style.top = (10 + Math.random() * 40) + '%';
      hole.appendChild(s);
      setTimeout(() => s.remove(), 700);
    }
  }

  function endGame() {
    gameActive = false;
    clearTimeout(moleTimer);
    clearInterval(countdownTimer);
    timerEl.classList.remove('timer-low');
    clearAllMoles();
    finalScoreEl.textContent = score;
    if (score >= 20) resultMsgEl.textContent = '🏆 Amazing! You\'re a pro!';
    else if (score >= 10) resultMsgEl.textContent = '👍 Great job! Keep it up!';
    else resultMsgEl.textContent = '😄 Try again, you got this!';
    gameOverEl.style.display = 'flex';
    if (score >= 10) launchEmojis();
  }

  function clearAllMoles() {
    grid.querySelectorAll('.hole').forEach(h => {
      h.classList.remove('active', 'whacked');
    });
    activeMoles.clear();
  }

  function launchEmojis() {
    const rain = document.getElementById('emojiRain');
    rain.innerHTML = '';
    const emojis = ['🎉','⭐','🌟','🏆','💥','🎊','✨'];
    for (let i = 0; i < 18; i++) {
      const e = document.createElement('div');
      e.className = 'rain-emoji';
      e.textContent = emojis[Math.floor(Math.random()*emojis.length)];
      e.style.left = Math.random()*100 + 'vw';
      e.style.animationDuration = (1.5 + Math.random()*2) + 's';
      e.style.animationDelay = (Math.random()*1.5) + 's';
      rain.appendChild(e);
    }
    setTimeout(() => rain.innerHTML = '', 4000);
  }
</script>
</body>
</html>
